rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && id.size() <= 128 && (id.size() == 0 || id.matches('^[a-zA-Z0-9_\\-]+$'));
    }

    function isValidHexColorField(val) {
      return val is string && val.size() <= 7 && (val.size() == 0 || val.matches('^#[0-9a-fA-F]{6}$'));
    }

    function isValidLogoDataUrlField(val) {
      return val is string &&
        val.size() <= 500000 &&
        (
          val.size() == 0 ||
          (
            val.size() >= 20 &&
            val[0:11] == 'data:image/'
          )
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'instagram.okosteraker@gmail.com' ||
        request.auth.token.email == 'marcus.o.ahlen@gmail.com'
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
      );
    }

    function hasOfficialRole(role) {
      return isVerifiedUser() &&
        isOfficialRole(role) &&
        exists(/databases/$(database)/documents/roleAssignments/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roleAssignments/$(request.auth.uid)).data.role == role;
    }

    function parentCompetitionExists(competitionId) {
      return exists(/databases/$(database)/documents/competitions/$(competitionId));
    }

    function parentCompetitionData(competitionId) {
      return get(/databases/$(database)/documents/competitions/$(competitionId)).data;
    }

    // =========================================================================
    // Blueprint Validation Helpers (Anti-Update-Gap)
    // =========================================================================
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'inviteId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'inviteId', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() >= 10 && data.role.size() <= 11 &&
        (data.role == 'SUPER_ADMIN' || data.role == 'RACE_ADMIN') &&
        data.inviteId is string && data.inviteId.size() >= 1 && data.inviteId.size() <= 128 && data.inviteId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminInvite(data) {
      return data.keys().hasAll(['inviteId', 'email', 'displayName', 'role', 'active', 'createdByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['inviteId', 'email', 'displayName', 'role', 'active', 'createdByUid', 'createdAt', 'updatedAt', 'claimedUid']) &&
        data.inviteId is string && data.inviteId.size() >= 1 && data.inviteId.size() <= 128 && data.inviteId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() >= 10 && data.role.size() <= 11 &&
        (data.role == 'SUPER_ADMIN' || data.role == 'RACE_ADMIN') &&
        data.active is bool &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 && data.createdByUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (!('claimedUid' in data) || isValidId(data.claimedUid)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isOfficialRole(role) {
      return role == 'START' || role == 'READOUT' || role == 'FOREST' || role == 'SPEAKER';
    }

    function isValidRoleAssignment(data) {
      return data.keys().hasAll([
          'uid',
          'inviteId',
          'email',
          'displayName',
          'role',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'inviteId',
          'email',
          'displayName',
          'role',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isValidId(data.inviteId) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        isOfficialRole(data.role) &&
        isValidId(data.createdByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoleInvite(data) {
      return data.keys().hasAll([
          'inviteId',
          'email',
          'displayName',
          'role',
          'active',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'inviteId',
          'email',
          'displayName',
          'role',
          'active',
          'createdByUid',
          'claimedUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.inviteId) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        isOfficialRole(data.role) &&
        data.active is bool &&
        isValidId(data.createdByUid) &&
        (!('claimedUid' in data) || isValidId(data.claimedUid)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClubSettings(data) {
      return data.keys().hasAll([
          'settingId',
          'clubName',
          'eventorOrgId',
          'defaultDirectEntryFeeSek',
          'rentalCardFeeSek',
          'missingRentalFeeSek',
          'activeEventId',
          'demoCleared',
          'competitionIds',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'settingId',
          'clubName',
          'eventorOrgId',
          'defaultDirectEntryFeeSek',
          'rentalCardFeeSek',
          'missingRentalFeeSek',
          'portalTitle',
          'logoDataUrl',
          'customBgColor',
          'customTextColor',
          'customAccentColor',
          'seriesScoringSettings',
          'activeEventId',
          'demoCleared',
          'competitionIds',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.settingId is string && data.settingId.size() >= 1 && data.settingId.size() <= 64 && data.settingId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.clubName is string && data.clubName.size() >= 1 && data.clubName.size() <= 100 &&
        data.eventorOrgId is string && data.eventorOrgId.size() <= 32 &&
        data.defaultDirectEntryFeeSek is int && data.defaultDirectEntryFeeSek >= 0 && data.defaultDirectEntryFeeSek <= 10000 &&
        data.rentalCardFeeSek is int && data.rentalCardFeeSek >= 0 && data.rentalCardFeeSek <= 5000 &&
        data.missingRentalFeeSek is int && data.missingRentalFeeSek >= 0 && data.missingRentalFeeSek <= 20000 &&
        (!('portalTitle' in data) || (data.portalTitle is string && data.portalTitle.size() <= 80)) &&
        (!('logoDataUrl' in data) || isValidLogoDataUrlField(data.logoDataUrl)) &&
        (!('customBgColor' in data) || isValidHexColorField(data.customBgColor)) &&
        (!('customTextColor' in data) || isValidHexColorField(data.customTextColor)) &&
        (!('customAccentColor' in data) || isValidHexColorField(data.customAccentColor)) &&
        (!('seriesScoringSettings' in data) ||
          (data.seriesScoringSettings is map && data.seriesScoringSettings.size() <= 50)) &&
        isValidOptionalId(data.activeEventId) &&
        data.demoCleared is bool &&
        data.competitionIds is list && data.competitionIds.size() <= 100 &&
        (data.competitionIds.size() == 0 || (data.competitionIds[0] is string && data.competitionIds[0].size() <= 128)) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudCompetition(data) {
      return data.keys().hasAll([
          'competitionId',
          'shortCode',
          'name',
          'organizer',
          'date',
          'status',
          'zeroTimeStr',
          'zeroTimeSec',
          'arenaInfo',
          'seriesName',
          'competitorCount',
          'finishedCount',
          'brokenControls',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'competitionId',
          'shortCode',
          'name',
          'organizer',
          'date',
          'status',
          'statusOverride',
          'zeroTimeStr',
          'zeroTimeSec',
          'arenaInfo',
          'seriesName',
          'allowSelfRegistration',
          'feeTrackingEnabled',
          'enableFeesAndSwish',
          'competitorCount',
          'finishedCount',
          'brokenControls',
          'controlTimeOffsets',
          'pinStart',
          'pinReadout',
          'pinForest',
          'pinSpeaker',
          'pinsCustomized',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.competitionId is string && data.competitionId.size() >= 1 && data.competitionId.size() <= 128 && data.competitionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.shortCode is string && data.shortCode.size() >= 2 && data.shortCode.size() <= 32 && data.shortCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.organizer is string && data.organizer.size() >= 1 && data.organizer.size() <= 100 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.status is string && data.status.size() >= 4 && data.status.size() <= 9 &&
        (data.status == 'LIVE' || data.status == 'UPCOMING' || data.status == 'COMPLETED') &&
        data.zeroTimeStr is string && data.zeroTimeStr.size() >= 5 && data.zeroTimeStr.size() <= 8 && data.zeroTimeStr.matches('^\\d{2}:\\d{2}(:\\d{2})?$') &&
        data.zeroTimeSec is int && data.zeroTimeSec >= 0 && data.zeroTimeSec <= 86400 &&
        data.arenaInfo is string && data.arenaInfo.size() <= 500 &&
        data.seriesName is string && data.seriesName.size() <= 80 &&
        (
          !data.keys().hasAny(['allowSelfRegistration']) ||
          data.allowSelfRegistration is bool
        ) &&
        (
          !data.keys().hasAny(['statusOverride']) ||
          data.statusOverride is bool
        ) &&
        (
          ('feeTrackingEnabled' in data && data.feeTrackingEnabled is bool) ||
          // Read existing competitions created before the field was renamed.
          ('enableFeesAndSwish' in data && data.enableFeesAndSwish is bool)
        ) &&
        data.competitorCount is int && data.competitorCount >= 0 && data.competitorCount <= 50000 &&
        data.finishedCount is int && data.finishedCount >= 0 && data.finishedCount <= 50000 &&
        data.finishedCount <= data.competitorCount &&
        data.brokenControls is list && data.brokenControls.size() <= 64 &&
        (data.brokenControls.size() == 0 || data.brokenControls[0] is int) &&
        (
          !data.keys().hasAny(['controlTimeOffsets']) ||
          (
            data.controlTimeOffsets is map &&
            data.controlTimeOffsets.size() <= 64
          )
        ) &&
        (
          !data.keys().hasAny(['pinStart']) ||
          (data.pinStart is string && data.pinStart.size() >= 4 && data.pinStart.size() <= 6 && data.pinStart.matches('^\\d{4,6}$'))
        ) &&
        (
          !data.keys().hasAny(['pinReadout']) ||
          (data.pinReadout is string && data.pinReadout.size() >= 4 && data.pinReadout.size() <= 6 && data.pinReadout.matches('^\\d{4,6}$'))
        ) &&
        (
          !data.keys().hasAny(['pinForest']) ||
          (data.pinForest is string && data.pinForest.size() >= 4 && data.pinForest.size() <= 6 && data.pinForest.matches('^\\d{4,6}$'))
        ) &&
        (
          !data.keys().hasAny(['pinSpeaker']) ||
          (data.pinSpeaker is string && data.pinSpeaker.size() >= 4 && data.pinSpeaker.size() <= 6 && data.pinSpeaker.matches('^\\d{4,6}$'))
        ) &&
        (!data.keys().hasAny(['pinsCustomized']) || data.pinsCustomized is bool) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudCourse(data) {
      return data.keys().hasAll([
          'courseId',
          'competitionId',
          'name',
          'lengthMeters',
          'climbMeters',
          'controls',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId',
          'competitionId',
          'name',
          'lengthMeters',
          'climbMeters',
          'controls',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.courseId) &&
        isValidId(data.competitionId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.lengthMeters is int && data.lengthMeters >= 0 && data.lengthMeters <= 200000 &&
        data.climbMeters is int && data.climbMeters >= 0 && data.climbMeters <= 20000 &&
        data.controls is list && data.controls.size() <= 128 &&
        (data.controls.size() == 0 || data.controls[0] is int) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudClass(data) {
      return data.keys().hasAll([
          'classId',
          'competitionId',
          'name',
          'courseId',
          'classFormat',
          'forkCourseIds',
          'rogainingMaxTimeSec',
          'rogainingPenaltyPerMin',
          'allowDirectEntry',
          'freeStart',
          'autoMatchCourse',
          'feeSek',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'classId',
          'competitionId',
          'name',
          'courseId',
          'classFormat',
          'forkCourseIds',
          'rogainingMaxTimeSec',
          'rogainingPenaltyPerMin',
          'allowDirectEntry',
          'freeStart',
          'autoMatchCourse',
          'feeSek',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.classId) &&
        isValidId(data.competitionId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        isValidOptionalId(data.courseId) &&
        data.classFormat is string && data.classFormat.size() >= 6 && data.classFormat.size() <= 9 &&
        (data.classFormat == 'STANDARD' || data.classFormat == 'FORKED' || data.classFormat == 'ROGAINING') &&
        data.forkCourseIds is list && data.forkCourseIds.size() <= 32 &&
        (data.forkCourseIds.size() == 0 || (data.forkCourseIds[0] is string && data.forkCourseIds[0].size() <= 128)) &&
        data.rogainingMaxTimeSec is int && data.rogainingMaxTimeSec >= -1 && data.rogainingMaxTimeSec <= 86400 &&
        data.rogainingPenaltyPerMin is int && data.rogainingPenaltyPerMin >= -1 && data.rogainingPenaltyPerMin <= 1000 &&
        data.allowDirectEntry is bool &&
        data.freeStart is bool &&
        data.autoMatchCourse is bool &&
        data.feeSek is int && data.feeSek >= 0 && data.feeSek <= 10000 &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudCompetitor(data) {
      return data.keys().hasAll([
          'competitorId',
          'competitionId',
          'bib',
          'fullName',
          'club',
          'classId',
          'siNumber',
          'cardSeries',
          'isRentalCard',
          'rentalReturned',
          'feePaid',
          'status',
          'allocatedStartSec',
          'checkTimeSec',
          'startTimeSec',
          'finishTimeSec',
          'manualFinishTimeSec',
          'runningTimeSec',
          'readoutAtIso',
          'punchCodes',
          'punchTimes',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'competitorId',
          'competitionId',
          'bib',
          'fullName',
          'club',
          'classId',
          'siNumber',
          'cardSeries',
          'isRentalCard',
          'rentalReturned',
          'isSelfRegistered',
          'feePaid',
          'readoutReceiptId',
          'status',
          'allocatedStartSec',
          'checkTimeSec',
          'startTimeSec',
          'finishTimeSec',
          'manualFinishTimeSec',
          'runningTimeSec',
          'readoutAtIso',
          'punchCodes',
          'punchTimes',
          'ownerUid',
          'createdAt',
          'billingFieldsUpdatedAt',
          'updatedAt'
        ]) &&
        (
          !data.keys().hasAny(['billingFieldsUpdatedAt']) ||
          data.billingFieldsUpdatedAt is timestamp
        ) &&
        (
          !data.keys().hasAny(['readoutReceiptId']) ||
          isValidId(data.readoutReceiptId)
        ) &&
        isValidId(data.competitorId) &&
        isValidId(data.competitionId) &&
        data.bib is int && data.bib >= 1 && data.bib <= 99999 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.club is string && data.club.size() >= 1 && data.club.size() <= 100 &&
        isValidId(data.classId) &&
        data.siNumber is int && data.siNumber >= 1 && data.siNumber <= 99999999 &&
        data.cardSeries is string && data.cardSeries.size() >= 1 && data.cardSeries.size() <= 24 &&
        data.isRentalCard is bool &&
        data.rentalReturned is bool &&
        (
          !data.keys().hasAny(['isSelfRegistered']) ||
          data.isSelfRegistered is bool
        ) &&
        data.feePaid is bool &&
        data.status is string && data.status.size() >= 2 && data.status.size() <= 15 &&
        (
          data.status == 'REGISTERED' ||
          data.status == 'CHECKED' ||
          data.status == 'IN_FOREST' ||
          data.status == 'PRELIMINARY_FIN' ||
          data.status == 'OK' ||
          data.status == 'MP' ||
          data.status == 'DNF' ||
          data.status == 'DNS'
        ) &&
        data.allocatedStartSec is int && data.allocatedStartSec >= -1 && data.allocatedStartSec <= 86400 &&
        data.checkTimeSec is int && data.checkTimeSec >= -1 && data.checkTimeSec <= 86400 &&
        data.startTimeSec is int && data.startTimeSec >= -1 && data.startTimeSec <= 86400 &&
        data.finishTimeSec is int && data.finishTimeSec >= -1 && data.finishTimeSec <= 86400 &&
        data.manualFinishTimeSec is int && data.manualFinishTimeSec >= -1 && data.manualFinishTimeSec <= 86400 &&
        data.runningTimeSec is int && data.runningTimeSec >= -1 && data.runningTimeSec <= 86400 &&
        data.readoutAtIso is string && data.readoutAtIso.size() <= 40 &&
        data.punchCodes is list && data.punchCodes.size() <= 192 &&
        data.punchTimes is list && data.punchTimes.size() <= 192 &&
        data.punchCodes.size() == data.punchTimes.size() &&
        (data.punchCodes.size() == 0 || (data.punchCodes[0] is int && data.punchTimes[0] is int)) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudRunnerDbEntry(data) {
      return data.keys().hasAll([
          'runnerId',
          'siNumber',
          'cardSeries',
          'fullName',
          'club',
          'birthYear',
          'defaultClassName',
          'eventorPersonId',
          'eventorOrgId',
          'source',
          'updatedAtIso',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'runnerId',
          'siNumber',
          'cardSeries',
          'fullName',
          'club',
          'birthYear',
          'defaultClassName',
          'eventorPersonId',
          'eventorOrgId',
          'source',
          'updatedAtIso',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.runnerId) &&
        data.siNumber is int && data.siNumber >= 1 && data.siNumber <= 99999999 &&
        data.cardSeries is string && data.cardSeries.size() >= 1 && data.cardSeries.size() <= 24 &&
        data.fullName is string && data.fullName.size() <= 120 &&
        data.club is string && data.club.size() <= 100 &&
        (data.birthYear == null || (data.birthYear is int && data.birthYear >= 1900 && data.birthYear <= 2100)) &&
        data.defaultClassName is string && data.defaultClassName.size() <= 80 &&
        data.eventorPersonId is string && data.eventorPersonId.size() <= 128 &&
        data.eventorOrgId is string && data.eventorOrgId.size() <= 32 &&
        data.source is string &&
        (data.source == 'EVENTOR_API' || data.source == 'EVENTOR_XML' || data.source == 'MEOS_CSV' || data.source == 'LEARNED_ENTRY') &&
        data.updatedAtIso is string && data.updatedAtIso.size() <= 40 &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSICardAssignment(data) {
      return isValidSICardAssignmentFields(data) &&
        isValidId(data.competitionId);
    }

    function isValidSICardAssignmentForCreate(data) {
      return isValidSICardAssignmentFields(data);
    }

    function isValidSICardAssignmentFields(data) {
      return data.keys().hasAll([
          'competitionId',
          'siNumber',
          'cardSeries',
          'competitorId',
          'competitorDocumentId',
          'state',
          'assignmentVersion',
          'source',
          'ownerUid',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'competitionId',
          'siNumber',
          'cardSeries',
          'competitorId',
          'competitorDocumentId',
          'state',
          'assignmentVersion',
          'source',
          'ownerUid',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'previousCompetitorId',
          'retiredAt',
          'retirementReason',
          'conflictReason',
          'lastValidatedAt'
        ]) &&
        data.siNumber is int && data.siNumber >= 1 && data.siNumber <= 99999999 &&
        data.cardSeries is string && data.cardSeries.size() >= 1 && data.cardSeries.size() <= 24 &&
        data.competitorDocumentId == data.competitorId &&
        (data.state == 'ACTIVE' || data.state == 'RETIRED') &&
        data.assignmentVersion is int && data.assignmentVersion >= 1 && data.assignmentVersion <= 65535 &&
        data.source is string && (data.source == 'DIRECT_ENTRY' || data.source == 'IMPORT' || data.source == 'EVENTOR' || data.source == 'MANUAL' || data.source == 'READOUT' || data.source == 'SYSTEM') &&
        isValidId(data.ownerUid) &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('previousCompetitorId' in data) || data.previousCompetitorId == null || (data.previousCompetitorId is string && data.previousCompetitorId.size() <= 128)) &&
        (!('retiredAt' in data) || data.retiredAt == null || data.retiredAt is timestamp) &&
        (!('retirementReason' in data) || data.retirementReason == null || (data.retirementReason is string && data.retirementReason.size() <= 200)) &&
        (!('conflictReason' in data) || data.conflictReason == null || (data.conflictReason is string && data.conflictReason.size() <= 200)) &&
        (!('lastValidatedAt' in data) || data.lastValidatedAt == null || data.lastValidatedAt is timestamp);
    }

    function activeSIAssignmentMatchesCompetitor(
      competitionId,
      siNumber,
      competitorId,
      ownerUid,
      assignment,
      competitor
    ) {
      return assignment.state == 'ACTIVE' &&
        assignment.competitionId == competitionId &&
        assignment.siNumber == siNumber &&
        assignment.competitorId == competitorId &&
        assignment.competitorDocumentId == competitorId &&
        assignment.ownerUid == ownerUid &&
        competitor.competitorId == competitorId &&
        competitor.competitionId == competitionId &&
        competitor.siNumber == siNumber &&
        competitor.cardSeries == assignment.cardSeries &&
        competitor.ownerUid == ownerUid;
    }

    function hasActiveSIAssignmentAfter(competitionId, siNumber, competitorId, ownerUid) {
      let assignmentPath =
        /databases/$(database)/documents/competitions/$(competitionId)/siCardAssignments/$(string(siNumber));
      let competitorPath =
        /databases/$(database)/documents/competitions/$(competitionId)/competitors/$(competitorId);
      return existsAfter(assignmentPath) &&
        existsAfter(competitorPath) &&
        activeSIAssignmentMatchesCompetitor(
          competitionId,
          siNumber,
          competitorId,
          ownerUid,
          getAfter(assignmentPath).data,
          getAfter(competitorPath).data
        );
    }

    function hasRetiredSIAssignmentAfter(competitionId, siNumber, competitorId) {
      return existsAfter(
          /databases/$(database)/documents/competitions/$(competitionId)/siCardAssignments/$(string(siNumber))
        ) &&
        getAfter(
          /databases/$(database)/documents/competitions/$(competitionId)/siCardAssignments/$(string(siNumber))
        ).data.state == 'RETIRED' &&
        getAfter(
          /databases/$(database)/documents/competitions/$(competitionId)/siCardAssignments/$(string(siNumber))
        ).data.competitorId == competitorId;
    }

    function hasCompetitorSIOrLifecycleMutationAfter(competitionId, competitorId) {
      let competitorPath =
        /databases/$(database)/documents/competitions/$(competitionId)/competitors/$(competitorId);
      return isValidId(competitorId) &&
        competitorSIOrLifecycleMutationExistsAfter(competitorPath);
    }

    function competitorSIOrLifecycleMutationExistsAfter(competitorPath) {
      let competitorExistsBefore = exists(competitorPath);
      let competitorExistsAfter = existsAfter(competitorPath);
      return
        (
          (!competitorExistsBefore && competitorExistsAfter) ||
          (competitorExistsBefore && !competitorExistsAfter) ||
          (
            competitorExistsBefore &&
            competitorExistsAfter &&
            getAfter(competitorPath).data.diff(get(competitorPath).data)
              .affectedKeys().hasAny(['siNumber', 'cardSeries', 'status', 'updatedAt'])
          )
        );
    }

    function activeAssignmentMatchesCompetitor(competitionId, assignment, competitor) {
      return competitor.siNumber == assignment.siNumber &&
        competitor.competitorId == assignment.competitorId &&
        competitor.competitionId == competitionId &&
        competitor.cardSeries == assignment.cardSeries &&
        competitor.ownerUid == assignment.ownerUid;
    }

    function retiredAssignmentMatchesCompetitorBefore(competitionId, assignment, competitor) {
      return competitor.competitorId == assignment.competitorId &&
        competitor.competitionId == competitionId &&
        competitor.siNumber == assignment.siNumber &&
        competitor.cardSeries == assignment.cardSeries &&
        competitor.ownerUid == assignment.ownerUid;
    }

    function retiredAssignmentMatchesCompetitorAfter(competitionId, assignment, competitor) {
      return competitor.competitorId == assignment.competitorId &&
        competitor.competitionId == competitionId &&
        competitor.ownerUid == assignment.ownerUid &&
        (
          competitor.siNumber != assignment.siNumber ||
          competitor.status == 'DNS' ||
          competitor.status == 'DNF'
        );
    }

    function assignmentMatchesCompetitorAfter(competitionId, assignment) {
      let competitorPath =
        /databases/$(database)/documents/competitions/$(competitionId)/competitors/$(assignment.competitorId);
      return isValidId(assignment.competitorId) &&
        (
          assignment.state == 'ACTIVE'
            ? existsAfter(competitorPath) &&
              activeAssignmentMatchesCompetitor(
                competitionId,
                assignment,
                getAfter(competitorPath).data
              )
            : assignment.state == 'RETIRED' &&
              exists(competitorPath) &&
              retiredAssignmentMatchesCompetitorBefore(
                competitionId,
                assignment,
                get(competitorPath).data
              ) &&
              (
                !existsAfter(competitorPath) ||
                retiredAssignmentMatchesCompetitorAfter(
                  competitionId,
                  assignment,
                  getAfter(competitorPath).data
                )
              )
        );
    }

    function canCreateReadoutCompetitor() {
      return hasOfficialRole('READOUT') ||
        hasOfficialRole('FOREST') ||
        hasOfficialRole('SPEAKER');
    }

    function processedReadoutReceiptMatchesCompetitor(competitor, receipt) {
      return receipt.status == 'PROCESSED' &&
        receipt.competitorId == competitor.competitorId &&
        receipt.siNumber == competitor.siNumber &&
        receipt.cardSeries == competitor.cardSeries &&
        receipt.ownerUid == request.auth.uid;
    }

    function hasProcessedReadoutReceiptAfter(competitionId, competitor) {
      let receiptPath =
        /databases/$(database)/documents/competitions/$(competitionId)/readoutReceipts/$(competitor.readoutReceiptId);
      return isValidId(competitor.readoutReceiptId) &&
        existsAfter(receiptPath) &&
        processedReadoutReceiptMatchesCompetitor(
          competitor,
          getAfter(receiptPath).data
        );
    }

    function runnerDbMatchesReadoutCompetitor(competitor, runnerDbEntry) {
      return competitor.fullName == runnerDbEntry.fullName &&
        (
          competitor.club == runnerDbEntry.club ||
          (
            runnerDbEntry.club == '' &&
            competitor.club == 'Klubblös'
          )
        ) &&
        competitor.cardSeries == runnerDbEntry.cardSeries;
    }

    function readoutCompetitorMatchesRunnerDbData(competitionId, competitor) {
      return competitor.competitionId == competitionId &&
        readoutCompetitorIdentityMatchesRunnerDbData(competitionId, competitor);
    }

    function readoutCompetitorIdentityMatchesRunnerDbData(competitionId, competitor) {
      let runnerDbPath =
        /databases/$(database)/documents/runnerDb/$(string(competitor.siNumber));
      return hasProcessedReadoutReceiptAfter(competitionId, competitor) &&
        exists(runnerDbPath) &&
        runnerDbMatchesReadoutCompetitor(
          competitor,
          get(runnerDbPath).data
        );
    }

    function readoutCompetitorMatchesRunnerDb(competitionId, competitorId) {
      let competitorPath =
        /databases/$(database)/documents/competitions/$(competitionId)/competitors/$(competitorId);
      return canCreateReadoutCompetitor() &&
        isValidId(competitorId) &&
        existsAfter(competitorPath) &&
        readoutCompetitorMatchesRunnerDbData(
          competitionId,
          getAfter(competitorPath).data
        );
    }

    function activeReadoutAssignmentCreateMatchesCompetitor(
      competitionId,
      assignment,
      competitor
    ) {
      return activeAssignmentMatchesCompetitor(
          competitionId,
          assignment,
          competitor
        ) &&
        (
          isAdmin() ||
          (
            assignment.ownerUid == request.auth.uid &&
            canCreateReadoutCompetitor() &&
            assignment.source == 'READOUT' &&
            assignment.state == 'ACTIVE' &&
            readoutCompetitorIdentityMatchesRunnerDbData(competitionId, competitor)
          )
        );
    }

    function assignmentCreateMatchesCompetitorAfter(competitionId, assignment) {
      let competitorPath =
        /databases/$(database)/documents/competitions/$(competitionId)/competitors/$(assignment.competitorId);
      return isValidId(assignment.competitorId) &&
        (
          assignment.state == 'ACTIVE'
            ? existsAfter(competitorPath) &&
              activeReadoutAssignmentCreateMatchesCompetitor(
                competitionId,
                assignment,
                getAfter(competitorPath).data
              )
            : assignmentMatchesCompetitorAfter(competitionId, assignment) &&
              isAdmin()
        );
    }

    // =========================================================================
    // 1. /admins/{userId} — Non-PII RBAC Profiles
    // =========================================================================
    match /admins/{userId} {
      allow get: if isVerifiedUser() &&
        isValidId(userId) &&
        (request.auth.uid == userId || isAdmin());

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidAdminRole(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isBootstrappedAdmin() &&
            incoming().role == 'SUPER_ADMIN' &&
            incoming().inviteId == 'bootstrap_super_admin'
          ) ||
          (
            exists(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)) &&
            get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.active == true &&
            get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.email == request.auth.token.email &&
            incoming().role == get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.role
          )
        );

      allow update: if (
        isVerifiedUser() &&
        isValidAdminRole(incoming()) &&
        isValidId(userId) &&
        resource != null &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Owner updates displayName only (RBAC fields locked)
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().inviteId == existing().inviteId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          ) ||
          // Action 2: Super Admin role management override
          (
            isSuperAdmin() &&
            incoming().inviteId == existing().inviteId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt'])
          )
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        resource != null &&
        userId != request.auth.uid &&
        isSuperAdmin();
    }

    // =========================================================================
    // 2. /adminInvites/{inviteId} — PII-Isolated Club Admin Invitations
    // =========================================================================
    match /adminInvites/{inviteId} {
      allow get: if isVerifiedUser() &&
        isValidId(inviteId) &&
        (
          (resource != null && resource.data.email == request.auth.token.email) ||
          isAdmin()
        );

      allow list: if isVerifiedUser() &&
        resource.data.createdByUid == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(inviteId) &&
        isValidAdminInvite(incoming()) &&
        incoming().inviteId == inviteId &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        (incoming().role == 'RACE_ADMIN' || isSuperAdmin());

      allow update: if (
        isVerifiedUser() &&
        isValidAdminInvite(incoming()) &&
        isValidId(inviteId) &&
        resource != null &&
        incoming().inviteId == existing().inviteId &&
        incoming().email == existing().email &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Creator toggles active state or updates displayName
          (
            existing().createdByUid == request.auth.uid &&
            incoming().role == existing().role &&
            (!('claimedUid' in existing()) || incoming().claimedUid == existing().claimedUid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'active', 'updatedAt']) &&
            isAdmin()
          ) ||
          // Action 2: Super Admin override
          (
            isSuperAdmin() &&
            (!('claimedUid' in existing()) || incoming().claimedUid == existing().claimedUid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt'])
          ) ||
          (
            isAdmin() &&
            existing().email == request.auth.token.email &&
            existing().active == true &&
            incoming().active == false &&
            incoming().inviteId == existing().inviteId &&
            incoming().email == existing().email &&
            incoming().displayName == existing().displayName &&
            incoming().role == existing().role &&
            incoming().createdByUid == existing().createdByUid &&
            incoming().createdAt == existing().createdAt &&
            incoming().claimedUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['active', 'claimedUid', 'updatedAt'])
          )
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(inviteId) &&
        resource != null &&
        (
          (existing().createdByUid == request.auth.uid && isAdmin()) ||
          isSuperAdmin()
        );
    }

    match /roleAssignments/{userId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          (request.auth.uid == userId || isAdmin());

        allow list: if isVerifiedUser() && isAdmin();

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          userId == request.auth.uid &&
          isValidRoleAssignment(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().email == request.auth.token.email &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/roleInvites/$(incoming().inviteId)) &&
          getAfter(/databases/$(database)/documents/roleInvites/$(incoming().inviteId)).data.email == request.auth.token.email &&
          getAfter(/databases/$(database)/documents/roleInvites/$(incoming().inviteId)).data.role == incoming().role &&
          getAfter(/databases/$(database)/documents/roleInvites/$(incoming().inviteId)).data.createdByUid == incoming().createdByUid &&
          getAfter(/databases/$(database)/documents/roleInvites/$(incoming().inviteId)).data.active == false &&
          getAfter(/databases/$(database)/documents/roleInvites/$(incoming().inviteId)).data.claimedUid == request.auth.uid;

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          resource != null &&
          isValidRoleAssignment(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt']);

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          resource != null &&
          isAdmin();
    }

    match /roleInvites/{inviteId} {
        allow get: if isVerifiedUser() &&
          isValidId(inviteId) &&
          (
            (resource != null && resource.data.email == request.auth.token.email) ||
            isAdmin()
          );

        allow list: if isVerifiedUser() && isAdmin();

        allow create: if isVerifiedUser() &&
          isValidId(inviteId) &&
          isValidRoleInvite(incoming()) &&
          incoming().inviteId == inviteId &&
          incoming().createdByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          incoming().active == true &&
          !('claimedUid' in incoming()) &&
          isAdmin();

        allow update: if isVerifiedUser() &&
          isValidId(inviteId) &&
          resource != null &&
          isValidRoleInvite(incoming()) &&
          incoming().inviteId == existing().inviteId &&
          incoming().email == existing().email &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt'])
            ) ||
            (
              existing().active == true &&
              existing().email == request.auth.token.email &&
              incoming().active == false &&
              incoming().claimedUid == request.auth.uid &&
              incoming().role == existing().role &&
              incoming().displayName == existing().displayName &&
              incoming().diff(existing()).affectedKeys().hasOnly(['active', 'claimedUid', 'updatedAt']) &&
              getAfter(/databases/$(database)/documents/roleAssignments/$(request.auth.uid)).data.role == existing().role
            )
          );

        allow delete: if isVerifiedUser() && isAdmin();
    }

    // =========================================================================
    // 3. /clubSettings/{settingId} — Singleton Club Configuration
    // =========================================================================
    match /clubSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'default';

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(settingId) &&
        settingId == 'default' &&
        isValidClubSettings(incoming()) &&
        incoming().settingId == settingId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if (
        isVerifiedUser() &&
        isValidClubSettings(incoming()) &&
        isValidId(settingId) &&
        settingId == 'default' &&
        resource != null &&
        incoming().settingId == existing().settingId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Owner admin updates club settings
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'clubName',
              'eventorOrgId',
              // Permit cleanup of these fields from pre-existing club documents.
              'swishNumber',
              'swishRecipientName',
              'defaultDirectEntryFeeSek',
              'rentalCardFeeSek',
              'missingRentalFeeSek',
              'portalTitle',
              'logoDataUrl',
              'customBgColor',
              'customTextColor',
              'customAccentColor',
              'seriesScoringSettings',
              'activeEventId',
              'demoCleared',
              'competitionIds',
              'updatedAt'
            ]) &&
            isAdmin()
          ) ||
          // Action 2: Super Admin escape hatch
          (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'clubName',
              'eventorOrgId',
              'swishNumber',
              'swishRecipientName',
              'defaultDirectEntryFeeSek',
              'rentalCardFeeSek',
              'missingRentalFeeSek',
              'portalTitle',
              'logoDataUrl',
              'customBgColor',
              'customTextColor',
              'customAccentColor',
              'seriesScoringSettings',
              'activeEventId',
              'demoCleared',
              'competitionIds',
              'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'eventorOrgId',
              'updatedAt'
            ])
          )
        )
      );

      allow delete: if isVerifiedUser() &&
        isValidId(settingId) &&
        resource != null &&
        isSuperAdmin();

      match /private/{privateId} {
        function isValidPrivateEventorConfig(data) {
          return data.keys().hasOnly([
              'apiKey',
              'orgId',
              'baseUrl',
              'lastSyncedAt',
              'connectedOrgId',
              'connectedOrgName',
              'connectedEventId'
            ]) &&
            (!('apiKey' in data) || (data.apiKey is string && data.apiKey.size() <= 512)) &&
            (!('orgId' in data) || (data.orgId is string && data.orgId.size() <= 32)) &&
            (!('baseUrl' in data) || (data.baseUrl is string && data.baseUrl.size() <= 500)) &&
            (!('lastSyncedAt' in data) || (data.lastSyncedAt is string && data.lastSyncedAt.size() <= 40)) &&
            (!('connectedOrgId' in data) || (data.connectedOrgId is string && data.connectedOrgId.size() <= 32)) &&
            (!('connectedOrgName' in data) || (data.connectedOrgName is string && data.connectedOrgName.size() <= 150)) &&
            (!('connectedEventId' in data) || (data.connectedEventId is string && data.connectedEventId.size() <= 32));
        }

        allow get: if isValidId(settingId) &&
          settingId == 'default' &&
          privateId == 'eventor' &&
          isAdmin();
        allow list: if false;
        allow create, update: if isValidId(settingId) &&
          settingId == 'default' &&
          privateId == 'eventor' &&
          isAdmin() &&
          isValidPrivateEventorConfig(incoming());
        allow delete: if isValidId(settingId) &&
          settingId == 'default' &&
          privateId == 'eventor' &&
          isAdmin();
      }
    }

    // =========================================================================
    // 4. /runnerDb/{siNumber} — admins and assigned officials may read runner lookup data
    // =========================================================================
    match /runnerDb/{siNumber} {
      allow get: if isVerifiedUser() &&
        isValidId(siNumber) &&
        (
          isAdmin() ||
          hasOfficialRole('START') ||
          hasOfficialRole('READOUT') ||
          hasOfficialRole('FOREST') ||
          hasOfficialRole('SPEAKER')
        );
      allow list: if isVerifiedUser() &&
        (
          isAdmin() ||
          hasOfficialRole('START') ||
          hasOfficialRole('READOUT') ||
          hasOfficialRole('FOREST') ||
          hasOfficialRole('SPEAKER')
        );

      allow create: if isVerifiedUser() &&
        isValidId(siNumber) &&
        isValidCloudRunnerDbEntry(incoming()) &&
        incoming().runnerId == siNumber &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(siNumber) &&
        resource != null &&
        isValidCloudRunnerDbEntry(incoming()) &&
        incoming().runnerId == existing().runnerId &&
        incoming().siNumber == existing().siNumber &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'runnerId',
          'siNumber',
          'cardSeries',
          'fullName',
          'club',
          'birthYear',
          'defaultClassName',
          'eventorPersonId',
          'eventorOrgId',
          'source',
          'updatedAtIso',
          'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isVerifiedUser() &&
        isValidId(siNumber) &&
        resource != null &&
        isAdmin();
    }

    // =========================================================================
    // 5. /competitions/{competitionId} — Cloud-Persisted Competitions + Subcollections
    // =========================================================================
    match /competitions/{competitionId} {
      allow get: if isValidId(competitionId);

      allow list: if isVerifiedUser();

      allow create: if isVerifiedUser() &&
        isValidId(competitionId) &&
        isValidCloudCompetition(incoming()) &&
        incoming().keys().hasAll(['feeTrackingEnabled']) &&
        !incoming().keys().hasAny(['enableFeesAndSwish']) &&
        incoming().competitionId == competitionId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if (
        isVerifiedUser() &&
        isValidCloudCompetition(incoming()) &&
        isValidId(competitionId) &&
        resource != null &&
        incoming().competitionId == existing().competitionId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Club Admin updates active/upcoming competition (Terminal State Locked once COMPLETED)
          (
            (
              existing().ownerUid == request.auth.uid ||
              isAdmin()
            ) &&
            existing().status != 'COMPLETED' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'shortCode',
              'name',
              'organizer',
              'date',
              'status',
              'statusOverride',
              'zeroTimeStr',
              'zeroTimeSec',
              'arenaInfo',
              'seriesName',
              'allowSelfRegistration',
              'feeTrackingEnabled',
              'competitorCount',
              'finishedCount',
              'brokenControls',
              'controlTimeOffsets',
              'pinStart',
              'pinReadout',
              'pinForest',
              'pinSpeaker',
              'pinsCustomized',
              'updatedAt'
            ]) &&
            isAdmin()
          ) ||
          // Action 2: Super Admin escape hatch (can also update/reopen COMPLETED competitions)
          (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'shortCode',
              'name',
              'organizer',
              'date',
              'status',
              'statusOverride',
              'zeroTimeStr',
              'zeroTimeSec',
              'arenaInfo',
              'seriesName',
              'allowSelfRegistration',
              'feeTrackingEnabled',
              'competitorCount',
              'finishedCount',
              'brokenControls',
              'controlTimeOffsets',
              'pinStart',
              'pinReadout',
              'pinForest',
              'pinSpeaker',
              'pinsCustomized',
              'updatedAt'
            ])
          ) ||
          // Action 3: Club Admin may reopen a completed competition by changing only its status.
          (
            isAdmin() &&
            existing().status == 'COMPLETED' &&
            (incoming().status == 'LIVE' || incoming().status == 'UPCOMING') &&
            incoming().statusOverride == true &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'statusOverride',
              'updatedAt'
            ])
          ) ||
          (
            canCreateReadoutCompetitor() &&
            existing().status != 'COMPLETED' &&
            incoming().competitorCount == existing().competitorCount + 1 &&
            incoming().finishedCount == existing().finishedCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'competitorCount',
              'finishedCount',
              'updatedAt'
            ])
          ) ||
          (
            canCreateReadoutCompetitor() &&
            existing().status != 'COMPLETED' &&
            incoming().finishedCount >= existing().finishedCount &&
            incoming().finishedCount <= existing().finishedCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'finishedCount',
              'updatedAt'
            ])
          )
        )
      );

      allow delete: if false;

      // -----------------------------------------------------------------------
      // 4a. /competitions/{competitionId}/siCardAssignments/{siNumber}
      // -----------------------------------------------------------------------
      // Assignment mutations must share a commit with a matching competitor
      // create, deletion, or relevant update. This is not a uniqueness query.
      match /siCardAssignments/{siNumber} {
        allow get: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(siNumber) &&
          parentCompetitionExists(competitionId) &&
          (isAdmin() || hasOfficialRole('READOUT'));

        allow list: if isVerifiedUser() &&
          isValidId(competitionId) &&
          parentCompetitionExists(competitionId) &&
          (isAdmin() || hasOfficialRole('READOUT'));

        allow create: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(siNumber) &&
          isValidSICardAssignmentForCreate(incoming()) &&
          incoming().competitionId == competitionId &&
          incoming().siNumber == int(siNumber) &&
          parentCompetitionExists(competitionId) &&
          hasCompetitorSIOrLifecycleMutationAfter(
            competitionId,
            incoming().competitorId
          ) &&
          assignmentCreateMatchesCompetitorAfter(competitionId, incoming());

        allow update: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(siNumber) &&
          isValidSICardAssignment(incoming()) &&
          resource != null &&
          incoming().competitionId == existing().competitionId &&
          incoming().siNumber == existing().siNumber &&
          incoming().createdAt == existing().createdAt &&
          (
            incoming().ownerUid == existing().ownerUid ||
            (existing().state == 'RETIRED' && incoming().state == 'ACTIVE')
          ) &&
          incoming().schemaVersion == existing().schemaVersion &&
          parentCompetitionExists(competitionId) &&
          hasCompetitorSIOrLifecycleMutationAfter(
            competitionId,
            incoming().competitorId
          ) &&
          assignmentMatchesCompetitorAfter(competitionId, incoming()) &&
          isAdmin();

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 4b. /competitions/{competitionId}/courses/{courseId} (Master Gate)
      // -----------------------------------------------------------------------
      match /courses/{courseId} {
        allow get: if isValidId(competitionId) &&
          isValidId(courseId) &&
          parentCompetitionExists(competitionId);

        allow list: if isValidId(competitionId) &&
          parentCompetitionExists(competitionId);

        allow create: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(courseId) &&
          isValidCloudCourse(incoming()) &&
          incoming().courseId == courseId &&
          incoming().competitionId == competitionId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (parentCompetitionData(competitionId).ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );

        allow update: if (
          isVerifiedUser() &&
          isValidCloudCourse(incoming()) &&
          isValidId(competitionId) &&
          isValidId(courseId) &&
          resource != null &&
          incoming().courseId == existing().courseId &&
          incoming().competitionId == existing().competitionId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            !incoming().diff(existing()).affectedKeys().hasAny([
              'feePaid',
              'rentalReturned'
            ]) ||
            incoming().billingFieldsUpdatedAt == request.time
          ) &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name',
                'lengthMeters',
                'climbMeters',
                'controls',
                'updatedAt'
              ]) &&
              isAdmin()
            ) ||
            (
              isSuperAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name',
                'lengthMeters',
                'climbMeters',
                'controls',
                'updatedAt'
              ])
            )
          )
        );

        allow delete: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(courseId) &&
          resource != null &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionExists(competitionId) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );

      }

      // -----------------------------------------------------------------------
      // 4b. /competitions/{competitionId}/classes/{classId} (Master Gate)
      // -----------------------------------------------------------------------
      match /classes/{classId} {
        allow get: if isValidId(competitionId) &&
          isValidId(classId) &&
          parentCompetitionExists(competitionId);

        allow list: if isValidId(competitionId) &&
          parentCompetitionExists(competitionId);

        allow create: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(classId) &&
          isValidCloudClass(incoming()) &&
          incoming().classId == classId &&
          incoming().competitionId == competitionId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (parentCompetitionData(competitionId).ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );

        allow update: if (
          isVerifiedUser() &&
          isValidCloudClass(incoming()) &&
          isValidId(competitionId) &&
          isValidId(classId) &&
          resource != null &&
          incoming().classId == existing().classId &&
          incoming().competitionId == existing().competitionId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name',
                'courseId',
                'classFormat',
                'forkCourseIds',
                'rogainingMaxTimeSec',
                'rogainingPenaltyPerMin',
                'allowDirectEntry',
                'freeStart',
                'autoMatchCourse',
                'feeSek',
                'updatedAt'
              ]) &&
              isAdmin()
            ) ||
            (
              isSuperAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name',
                'courseId',
                'classFormat',
                'forkCourseIds',
                'rogainingMaxTimeSec',
                'rogainingPenaltyPerMin',
                'allowDirectEntry',
                'freeStart',
                'autoMatchCourse',
                'feeSek',
                'updatedAt'
              ])
            )
          )
        );

        allow delete: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(classId) &&
          resource != null &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionExists(competitionId) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );
      }

      // -----------------------------------------------------------------------
      // 4c. /competitions/{competitionId}/competitors/{competitorId} (Master Gate)
      // -----------------------------------------------------------------------
      // P0 Step 7: identity writes must update the corresponding SI assignment
      // in the same commit; unrelated readout/status fields keep their existing
      // role checks and do not run assignment uniqueness queries.
      match /competitors/{competitorId} {
        allow get: if isValidId(competitionId) &&
          isValidId(competitorId) &&
          parentCompetitionExists(competitionId);

        allow list: if isValidId(competitionId) &&
          parentCompetitionExists(competitionId);

        allow create: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(competitorId) &&
          isValidCloudCompetitor(incoming()) &&
          incoming().competitorId == competitorId &&
          incoming().competitionId == competitionId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentCompetitionExists(competitionId) &&
          hasActiveSIAssignmentAfter(
            competitionId,
            incoming().siNumber,
            incoming().competitorId,
            incoming().ownerUid
          ) &&
          (
            (
              (parentCompetitionData(competitionId).ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin() ||
            (
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              readoutCompetitorMatchesRunnerDb(competitionId, competitorId)
            )
          );

        allow update: if (
          isVerifiedUser() &&
          isValidCloudCompetitor(incoming()) &&
          isValidId(competitionId) &&
          isValidId(competitorId) &&
          resource != null &&
          incoming().competitorId == existing().competitorId &&
          incoming().competitionId == existing().competitionId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentCompetitionExists(competitionId) &&
          (
            (
              incoming().siNumber == existing().siNumber &&
              (
                incoming().cardSeries == existing().cardSeries ||
                hasActiveSIAssignmentAfter(
                  competitionId,
                  incoming().siNumber,
                  incoming().competitorId,
                  incoming().ownerUid
                )
              )
            ) ||
            (
              incoming().siNumber != existing().siNumber &&
              hasRetiredSIAssignmentAfter(
                competitionId,
                existing().siNumber,
                competitorId
              ) &&
              hasActiveSIAssignmentAfter(
                competitionId,
                incoming().siNumber,
                incoming().competitorId,
                incoming().ownerUid
              )
            )
          ) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'bib',
                'fullName',
                'club',
                'classId',
                'siNumber',
                'cardSeries',
                'isRentalCard',
                'rentalReturned',
                'feePaid',
                'status',
                'allocatedStartSec',
                'checkTimeSec',
                'startTimeSec',
                'finishTimeSec',
                'manualFinishTimeSec',
                'runningTimeSec',
                'readoutAtIso',
                'punchCodes',
                'punchTimes',
                'billingFieldsUpdatedAt',
                'updatedAt'
              ]) &&
              isAdmin()
            ) ||
            (
              isSuperAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'bib',
                'fullName',
                'club',
                'classId',
                'siNumber',
                'cardSeries',
                'isRentalCard',
                'rentalReturned',
                'feePaid',
                'status',
                'allocatedStartSec',
                'checkTimeSec',
                'startTimeSec',
                'finishTimeSec',
                'manualFinishTimeSec',
                'runningTimeSec',
                'readoutAtIso',
                'punchCodes',
                'punchTimes',
                'billingFieldsUpdatedAt',
                'updatedAt'
              ])
            ) ||
            (
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              (
                (
                  hasOfficialRole('READOUT') ||
                  hasOfficialRole('SPEAKER') ||
                  hasOfficialRole('FOREST')
                ) &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status',
                  'checkTimeSec',
                  'startTimeSec',
                  'finishTimeSec',
                  'runningTimeSec',
                  'readoutAtIso',
                  'punchCodes',
                  'punchTimes',
                  'updatedAt'
                ])
              ) ||
              (
                hasOfficialRole('READOUT') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'rentalReturned',
                  'billingFieldsUpdatedAt',
                  'updatedAt'
                ])
              ) ||
              (
                hasOfficialRole('START') &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status',
                  'checkTimeSec',
                  'startTimeSec',
                  'updatedAt'
                ])
              )
            )
          )
        );

        allow delete: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(competitorId) &&
          resource != null &&
          hasRetiredSIAssignmentAfter(
            competitionId,
            existing().siNumber,
            competitorId
          ) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionExists(competitionId) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );
      }

      match /readoutReceipts/{receiptId} {
        function isValidReadoutReceipt(data) {
          return data.keys().hasAll([
              'receiptId',
              'competitionId',
              'ownerUid',
              'clientReadoutId',
              'siNumber',
              'cardSeries',
              'stationCode',
              'checkTimeSec',
              'startTimeSec',
              'finishTimeSec',
              'punchCodes',
              'punchTimes',
              'rawHex',
              'status',
              'competitorId',
              'createdAt'
            ]) &&
            data.keys().hasOnly([
              'receiptId',
              'competitionId',
              'ownerUid',
              'clientReadoutId',
              'siNumber',
              'cardSeries',
              'stationCode',
              'checkTimeSec',
              'startTimeSec',
              'finishTimeSec',
              'punchCodes',
              'punchTimes',
              'rawHex',
              'status',
              'competitorId',
              'createdAt'
            ]) &&
            isValidId(data.receiptId) &&
            isValidId(data.competitionId) &&
            isValidId(data.ownerUid) &&
            isValidId(data.clientReadoutId) &&
            data.siNumber is int && data.siNumber >= 1 && data.siNumber <= 99999999 &&
            data.cardSeries is string && data.cardSeries.size() >= 1 && data.cardSeries.size() <= 24 &&
            data.stationCode is int && data.stationCode >= 1 && data.stationCode <= 999 &&
            data.checkTimeSec is int && data.checkTimeSec >= -1 && data.checkTimeSec <= 86400 &&
            data.startTimeSec is int && data.startTimeSec >= -1 && data.startTimeSec <= 86400 &&
            data.finishTimeSec is int && data.finishTimeSec >= -1 && data.finishTimeSec <= 86400 &&
            data.punchCodes is list && data.punchCodes.size() <= 192 &&
            data.punchTimes is list && data.punchTimes.size() <= 192 &&
            data.punchCodes.size() == data.punchTimes.size() &&
            (data.punchCodes.size() == 0 || (data.punchCodes[0] is int && data.punchTimes[0] is int)) &&
            data.rawHex is string && data.rawHex.size() <= 2000 &&
            (data.status == 'UNKNOWN' || data.status == 'PROCESSED') &&
            (data.competitorId == '' || isValidId(data.competitorId)) &&
            data.createdAt is timestamp;
        }

        allow get: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(receiptId) &&
          parentCompetitionExists(competitionId) &&
          (
            isAdmin() ||
            hasOfficialRole('READOUT') ||
            hasOfficialRole('FOREST') ||
            hasOfficialRole('SPEAKER')
          ) &&
          (resource == null || existing().ownerUid == request.auth.uid);

        allow list: if isVerifiedUser() &&
          isValidId(competitionId) &&
          parentCompetitionExists(competitionId) &&
          isAdmin();

        allow create: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(receiptId) &&
          isValidReadoutReceipt(incoming()) &&
          incoming().receiptId == receiptId &&
          incoming().competitionId == competitionId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().clientReadoutId == receiptId &&
          incoming().createdAt == request.time &&
          parentCompetitionExists(competitionId) &&
          parentCompetitionData(competitionId).status != 'COMPLETED' &&
          (
            isAdmin() ||
            hasOfficialRole('READOUT') ||
            hasOfficialRole('FOREST') ||
            hasOfficialRole('SPEAKER')
          );

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(receiptId) &&
          resource != null &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              (parentCompetitionData(competitionId).ownerUid == request.auth.uid || isAdmin()) &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );
      }

      match /stations/{stationId} {
        function isValidCloudStation(data) {
          return data.keys().hasAll([
              'stationId',
              'competitionId',
              'ownerUid',
              'stationCode',
              'name',
              'hardwareModel',
              'stationFunction',
              'baudRate',
              'extendedProtocol',
              'batteryMv',
              'firmware',
              'lastSeenAt',
              'active',
              'createdAt',
              'updatedAt'
            ]) &&
            data.keys().hasOnly([
              'stationId',
              'competitionId',
              'ownerUid',
              'stationCode',
              'name',
              'hardwareModel',
              'stationFunction',
              'baudRate',
              'extendedProtocol',
              'batteryMv',
              'firmware',
              'lastSeenAt',
              'active',
              'createdAt',
              'updatedAt'
            ]) &&
            isValidId(data.stationId) &&
            isValidId(data.competitionId) &&
            isValidId(data.ownerUid) &&
            data.stationCode is int && data.stationCode >= 1 && data.stationCode <= 999 &&
            data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
            (
              data.hardwareModel == 'BSM8-USB' ||
              data.hardwareModel == 'BSM7-USB' ||
              data.hardwareModel == 'SRR-USB (Air+)' ||
              data.hardwareModel == 'BSF9 Master' ||
              data.hardwareModel == 'BSF8 Master'
            ) &&
            (
              data.stationFunction == 'CLEAR' ||
              data.stationFunction == 'CHECK' ||
              data.stationFunction == 'START' ||
              data.stationFunction == 'RADIO' ||
              data.stationFunction == 'PREWARNING' ||
              data.stationFunction == 'FINISH' ||
              data.stationFunction == 'READOUT'
            ) &&
            (data.baudRate == 38400 || data.baudRate == 4800) &&
            data.extendedProtocol is bool &&
            data.batteryMv is int && data.batteryMv >= 0 && data.batteryMv <= 6000 &&
            data.firmware is string && data.firmware.size() <= 80 &&
            data.lastSeenAt is string && data.lastSeenAt.size() <= 40 &&
            data.active is bool &&
            data.createdAt is timestamp &&
            data.updatedAt is timestamp;
        }

        allow get: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(punchId) &&
          parentCompetitionExists(competitionId) &&
          (isAdmin() || hasOfficialRole('START') || hasOfficialRole('READOUT') || hasOfficialRole('FOREST')) &&
          (resource == null || existing().ownerUid == request.auth.uid);

        allow list: if isVerifiedUser() && isAdmin();

        allow create: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(stationId) &&
          isValidCloudStation(incoming()) &&
          incoming().stationId == stationId &&
          incoming().competitionId == competitionId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentCompetitionExists(competitionId) &&
          parentCompetitionData(competitionId).status != 'COMPLETED' &&
          (
            (
              (parentCompetitionData(competitionId).ownerUid == request.auth.uid || isAdmin()) &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );

        allow update: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(stationId) &&
          isValidCloudStation(incoming()) &&
          resource != null &&
          incoming().stationId == existing().stationId &&
          incoming().competitionId == existing().competitionId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'stationCode',
            'name',
            'hardwareModel',
            'stationFunction',
            'baudRate',
            'extendedProtocol',
            'batteryMv',
            'firmware',
            'lastSeenAt',
            'active',
            'updatedAt'
          ]) &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );

        allow delete: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(stationId) &&
          resource != null &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              parentCompetitionData(competitionId).status != 'COMPLETED' &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );
      }

      match /stationPunches/{punchId} {
        function isValidStationPunch(data) {
          return data.keys().hasAll([
              'punchId',
              'competitionId',
              'ownerUid',
              'clientPunchId',
              'siNumber',
              'stationCode',
              'punchTimeSec',
              'rawHex',
              'stationName',
              'stationFunction',
              'competitorId',
              'runningTimeSec',
              'isPrewarning',
              'createdAt'
            ]) &&
            data.keys().hasOnly([
              'punchId',
              'competitionId',
              'ownerUid',
              'clientPunchId',
              'siNumber',
              'stationCode',
              'punchTimeSec',
              'rawHex',
              'stationName',
              'stationFunction',
              'competitorId',
              'runningTimeSec',
              'isPrewarning',
              'createdAt'
            ]) &&
            isValidId(data.punchId) &&
            isValidId(data.competitionId) &&
            isValidId(data.ownerUid) &&
            isValidId(data.clientPunchId) &&
            data.siNumber is int && data.siNumber >= 1 && data.siNumber <= 99999999 &&
            data.stationCode is int && data.stationCode >= 1 && data.stationCode <= 999 &&
            data.punchTimeSec is int && data.punchTimeSec >= 0 && data.punchTimeSec <= 86400 &&
            data.rawHex is string && data.rawHex.size() <= 2000 &&
            data.stationName is string && data.stationName.size() >= 1 &&
              data.stationName.size() <= 120 &&
            (
              data.stationFunction == 'CLEAR' ||
              data.stationFunction == 'CHECK' ||
              data.stationFunction == 'START' ||
              data.stationFunction == 'RADIO' ||
              data.stationFunction == 'PREWARNING' ||
              data.stationFunction == 'FINISH' ||
              data.stationFunction == 'READOUT'
            ) &&
            (data.competitorId == '' || isValidId(data.competitorId)) &&
            data.runningTimeSec is int &&
              data.runningTimeSec >= -1 && data.runningTimeSec <= 86400 &&
            data.isPrewarning is bool &&
            data.createdAt is timestamp;
        }

        allow get, list: if isVerifiedUser() &&
          isValidId(competitionId) &&
          parentCompetitionExists(competitionId) &&
          (
            parentCompetitionData(competitionId).ownerUid == request.auth.uid ||
            isAdmin() ||
            isSuperAdmin()
          ) &&
          isAdmin();

        allow create: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(punchId) &&
          isValidStationPunch(incoming()) &&
          incoming().punchId == punchId &&
          incoming().clientPunchId == punchId &&
          incoming().competitionId == competitionId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          parentCompetitionExists(competitionId) &&
          parentCompetitionData(competitionId).status != 'COMPLETED' &&
          (
            isAdmin() ||
            (
              hasOfficialRole('START') &&
              (
                incoming().stationFunction == 'CHECK' ||
                incoming().stationFunction == 'START' ||
                incoming().stationFunction == 'RADIO' ||
                incoming().stationFunction == 'PREWARNING'
              )
            ) ||
            (
              hasOfficialRole('READOUT') &&
              (
                incoming().stationFunction == 'CHECK' ||
                incoming().stationFunction == 'START' ||
                incoming().stationFunction == 'RADIO' ||
                incoming().stationFunction == 'PREWARNING' ||
                incoming().stationFunction == 'FINISH' ||
                incoming().stationFunction == 'READOUT'
              )
            ) ||
            (
              hasOfficialRole('FOREST') &&
              (
                incoming().stationFunction == 'RADIO' ||
                incoming().stationFunction == 'PREWARNING'
              )
            )
          );

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isValidId(competitionId) &&
          isValidId(punchId) &&
          resource != null &&
          parentCompetitionExists(competitionId) &&
          (
            (
              (existing().ownerUid == request.auth.uid || isAdmin()) &&
              (parentCompetitionData(competitionId).ownerUid == request.auth.uid || isAdmin()) &&
              isAdmin()
            ) ||
            isSuperAdmin()
          );
      }
    }
  }
}
